# Dockerfile.godot — CARCOSA Godot Client
# Godot 4.6 headless + xvfb para correr la UI sin display real
#
# Build:  docker build -f Dockerfile.godot -t carcosa:godot .
# Run:    docker run --rm -it \
#           -e DISPLAY=$DISPLAY \
#           -v /tmp/.X11-unix:/tmp/.X11-unix \
#           carcosa:godot
#
# Alternativa sin X11 (headless + xvfb):
#   docker run --rm -it carcosa:godot --headless

FROM debian:bookworm-slim

# Evitar prompts interactivos
ENV DEBIAN_FRONTEND=noninteractive

# Dependencias mínimas para Godot + X11 forwarding
RUN apt-get update && apt-get install -y --no-install-recommends \
	xvfb \
	x11vnc \
	xauth \
	libxcursor1 \
	libxrandr2 \
	libxinerama1 \
	libxi6 \
	libgl1-mesa-glx \
	libglib2.0-0 \
	libasound2 \
	libpulse0 \
	libdbus-1-3 \
	fonts-liberation \
	ca-certificates \
	wget \
	unzip \
	&& rm -rf /var/lib/apt/lists/*

# Godot 4.6 stable (headless build)
ARG GODOT_VERSION=4.6-stable
ARG GODOT_URL=https://github.com/godotengine/godot/releases/download/${GODOT_VERSION}/Godot_v${GODOT_VERSION}_linux.x86_64.zip
ARG GODOT_TEMPLATES_URL=https://github.com/godotengine/godot/releases/download/${GODOT_VERSION}/Godot_v${GODOT_VERSION}_export_templates.tpz

RUN wget -q "${GODOT_URL}" -O /tmp/godot.zip \
	&& unzip -q /tmp/godot.zip -d /opt/godot \
	&& mv /opt/godot/Godot_v${GODOT_VERSION}_linux.x86_64 /opt/godot/godot \
	&& chmod +x /opt/godot/godot \
	&& ln -s /opt/godot/godot /usr/local/bin/godot \
	&& rm /tmp/godot.zip

# Descargar e instalar export templates de Godot
# Los templates van en ~/.local/share/godot/export_templates/<version>/
# El .tpz contiene una carpeta "templates/" que hay que aplanar
# Godot busca con punto: "4.6.stable" no "4.6-stable"
RUN wget -q "${GODOT_TEMPLATES_URL}" -O /tmp/godot_templates.tpz \
	&& mkdir -p /tmp/godot_templates_extract \
	&& cd /tmp/godot_templates_extract \
	&& unzip -q /tmp/godot_templates.tpz \
	&& mkdir -p /root/.local/share/godot/export_templates/4.6.stable \
	&& mv /tmp/godot_templates_extract/templates/* /root/.local/share/godot/export_templates/4.6.stable/ \
	&& mkdir -p /home/gris/.local/share/godot/export_templates/4.6.stable \
	&& cp /root/.local/share/godot/export_templates/4.6.stable/* /home/gris/.local/share/godot/export_templates/4.6.stable/ \
	&& rm -rf /tmp/godot_templates.tpz /tmp/godot_templates_extract \
	&& ls /root/.local/share/godot/export_templates/4.6.stable/

WORKDIR /app

# Copiar el proyecto Godot
COPY godot_client/ /app/godot_client/

# Script de entrada
COPY run_godot.sh /usr/local/bin/run_godot.sh
RUN chmod +x /usr/local/bin/run_godot.sh

# Puerto para VNC (acceso remoto al display virtual)
EXPOSE 5900

ENTRYPOINT ["/usr/local/bin/run_godot.sh"]
