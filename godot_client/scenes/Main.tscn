[gd_scene load_steps=4 format=3 uid="uid://carcosa_main_v1"]

[ext_resource type="Script" path="res://scripts/Main.gd" id="1_main"]
[ext_resource type="Script" path="res://scripts/BoardView.gd" id="2_board"]
[ext_resource type="Script" path="res://scripts/ActionPanel.gd" id="3_action"]

; ── Raíz ──────────────────────────────────────────────────────────────────────
[node name="Main" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1_main")

; ── LOBBY PANEL ───────────────────────────────────────────────────────────────
[node name="LobbyPanel" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="MarginContainer" type="MarginContainer" parent="LobbyPanel"]
layout_mode = 2
theme_override_constants/margin_left = 60
theme_override_constants/margin_top = 60
theme_override_constants/margin_right = 60
theme_override_constants/margin_bottom = 60

[node name="VBox" type="VBoxContainer" parent="LobbyPanel/MarginContainer"]
layout_mode = 2
theme_override_constants/separation = 18

[node name="Title" type="Label" parent="LobbyPanel/MarginContainer/VBox"]
layout_mode = 2
text = "CARCOSA — Partida Humana"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 28

[node name="Separator1" type="HSeparator" parent="LobbyPanel/MarginContainer/VBox"]
layout_mode = 2

[node name="SeedRow" type="HBoxContainer" parent="LobbyPanel/MarginContainer/VBox"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="SeedLabel" type="Label" parent="LobbyPanel/MarginContainer/VBox/SeedRow"]
layout_mode = 2
text = "Seed:"
vertical_alignment = 1

[node name="SeedInput" type="SpinBox" parent="LobbyPanel/MarginContainer/VBox/SeedRow"]
layout_mode = 2
size_flags_horizontal = 3
min_value = 1.0
max_value = 999999.0
value = 1.0

; ── Selector de cantidad de jugadores ─────────────────────────────────────────
[node name="PlayerCountRow" type="HBoxContainer" parent="LobbyPanel/MarginContainer/VBox"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="PlayerCountLabel" type="Label" parent="LobbyPanel/MarginContainer/VBox/PlayerCountRow"]
layout_mode = 2
text = "Jugadores:"
vertical_alignment = 1

[node name="PlayerCountInput" type="SpinBox" parent="LobbyPanel/MarginContainer/VBox/PlayerCountRow"]
layout_mode = 2
size_flags_horizontal = 1
min_value = 1.0
max_value = 4.0
value = 2.0
step = 1.0

; ── Nombres de jugadores (poblado dinámicamente por Main.gd) ─────────────────
[node name="PlayerNamesContainer" type="VBoxContainer" parent="LobbyPanel/MarginContainer/VBox"]
layout_mode = 2
theme_override_constants/separation = 6

; ── Sprint 5: URL del servidor (configurable para LAN / VPS) ─────────────────
[node name="ServerRow" type="HBoxContainer" parent="LobbyPanel/MarginContainer/VBox"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="ServerLabel" type="Label" parent="LobbyPanel/MarginContainer/VBox/ServerRow"]
layout_mode = 2
text = "Servidor:"
vertical_alignment = 1

[node name="ServerInput" type="LineEdit" parent="LobbyPanel/MarginContainer/VBox/ServerRow"]
layout_mode = 2
size_flags_horizontal = 3
text = "http://127.0.0.1:8765"
placeholder_text = "http://IP:8765"

[node name="StartButton" type="Button" parent="LobbyPanel/MarginContainer/VBox"]
layout_mode = 2
text = "Nueva partida"
theme_override_font_sizes/font_size = 16

[node name="HintLabel" type="Label" parent="LobbyPanel/MarginContainer/VBox"]
layout_mode = 2
text = "Inicia el servidor:  uvicorn sim.game_server:app --host 0.0.0.0 --port 8765\nPara LAN: cambia la URL al IP del host (ej. http://192.168.1.10:8765)"
horizontal_alignment = 1
autowrap_mode = 3
modulate = Color(0.7, 0.7, 0.7, 1.0)

; ── GAME PANEL ────────────────────────────────────────────────────────────────
[node name="GamePanel" type="VBoxContainer" parent="."]
visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 4

[node name="StatusLabel" type="Label" parent="GamePanel"]
layout_mode = 2
text = "Iniciando..."
horizontal_alignment = 1
theme_override_font_sizes/font_size = 14

[node name="HSplit" type="HSplitContainer" parent="GamePanel"]
layout_mode = 2
size_flags_vertical = 3
split_offset = 820

; ── BoardView (ScrollContainer con script BoardView.gd) ───────────────────────
[node name="BoardView" type="ScrollContainer" parent="GamePanel/HSplit"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
script = ExtResource("2_board")

[node name="Content" type="Label" parent="GamePanel/HSplit/BoardView"]
layout_mode = 2
size_flags_horizontal = 3
text = "..."

; ── ActionPanel (ScrollContainer con script ActionPanel.gd) ───────────────────
[node name="ActionPanel" type="ScrollContainer" parent="GamePanel/HSplit"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
script = ExtResource("3_action")

[node name="VBox" type="VBoxContainer" parent="GamePanel/HSplit/ActionPanel"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 6

[node name="TitleLabel" type="Label" parent="GamePanel/HSplit/ActionPanel/VBox"]
layout_mode = 2
text = "Acciones"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 14

[node name="ButtonsContainer" type="VBoxContainer" parent="GamePanel/HSplit/ActionPanel/VBox"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 4

[node name="SaveButton" type="Button" parent="GamePanel"]
layout_mode = 2
text = "Guardar sesión"

; ── RESULT PANEL ──────────────────────────────────────────────────────────────
[node name="ResultPanel" type="PanelContainer" parent="."]
visible = false
layout_mode = 1
anchor_left = 0.2
anchor_top = 0.25
anchor_right = 0.8
anchor_bottom = 0.75
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="ResultPanel"]
layout_mode = 2
theme_override_constants/separation = 20

[node name="ResultLabel" type="Label" parent="ResultPanel/VBox"]
layout_mode = 2
text = "Partida terminada."
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 3
theme_override_font_sizes/font_size = 16

[node name="NewGameButton" type="Button" parent="ResultPanel/VBox"]
layout_mode = 2
text = "Nueva partida"
theme_override_font_sizes/font_size = 14

; ── ERROR LABEL ───────────────────────────────────────────────────────────────
[node name="ErrorLabel" type="Label" parent="."]
visible = false
layout_mode = 1
anchor_left = 0.05
anchor_top = 0.88
anchor_right = 0.95
anchor_bottom = 0.96
grow_horizontal = 2
grow_vertical = 2
text = "Error"
horizontal_alignment = 1
vertical_alignment = 1
modulate = Color(1.0, 0.3, 0.3, 1.0)
